# Supabase PostgreSQL Connection String
# Lấy từ Supabase Dashboard -> Project Settings -> Database -> Connection string (URI hoặc .NET / ADO.NET)
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;

# JWT signing key (chuỗi ngẫu nhiên, tối thiểu 32 ký tự)
JWT_KEY=

# PayOS (https://my.payos.vn → Kênh thanh toán)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Gmail gửi email (dùng App Password, không dùng mật khẩu tài khoản)
EMAIL_SENDER=
EMAIL_PASSWORD=
